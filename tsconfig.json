{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [
      "bun",
      "react",
      "react-dom"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "scripts"
  ]
}
